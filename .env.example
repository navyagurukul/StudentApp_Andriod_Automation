# Copy to .env and adjust. Values here are the defaults.

# --- AltTester connection ---
# The app connects to an AltServer at this address; the driver connects here too.
ALT_HOST=127.0.0.1
ALT_PORT=13000
# AltServer app name the build registered (SDK default is __default__).
ALT_APP_NAME=__default__
ALT_CONNECT_TIMEOUT=30

# --- device / app under test ---
APP_PACKAGE=com.OritSciencesPrivateLimited.EnglishGurukul.student
APP_ACTIVITY=io.branch.unity.BranchUnityActivity
# Pin a specific device when several are attached (adb devices). Blank = the only one.
UDID=

# Auto `adb reverse` + launch the app when opening the driver.
# Set BOTH to false when driving the app from the Unity Editor (Play mode) on
# this machine — there is no device to adb-reverse or launch.
REVERSE_FORWARD=true
LAUNCH_APP=true

# --- reporting ---
# Version shown in the daily report header (blank = auto: live app -> adb -> apk).
APP_VERSION=
# Slack Incoming Webhook for run_daily.py.
SLACK_WEBHOOK_URL=

# --- test data (for login flow, once selectors are filled) ---
TEST_MOBILE=
TEST_PASSWORD=
